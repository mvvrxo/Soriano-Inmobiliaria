# Supabase (public values: safe in the browser, access is protected with RLS)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICABLE

# Email for the website forms (server only, never prefix with NEXT_PUBLIC_)
